<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFramework>net6.0</TargetFramework>
	  <ImplicitUsings>enable</ImplicitUsings>
	  <Nullable>disable</Nullable>
	  <LangVersion>latest</LangVersion>
	  <Version>2.1.0</Version>
	  <PlatformTarget>x64</PlatformTarget>
	  <ModManagerRoot>$(LOCALAPPDATA)\IdleSlayerModManager</ModManagerRoot>
	  <MelonLoaderDir>$(ModManagerRoot)\ModLoader\MelonLoader</MelonLoaderDir>
  </PropertyGroup>

  <!-- Reference the assemblies generated by a local Idle Slayer Mod Manager install (they match the installed game). -->
  <PropertyGroup Condition="Exists('$(MelonLoaderDir)\Il2CppAssemblies\Assembly-CSharp.dll')">
	  <Il2CppAssembliesDir>$(MelonLoaderDir)\Il2CppAssemblies</Il2CppAssembliesDir>
	  <SupportModulesDir>$(MelonLoaderDir)\Dependencies\SupportModules</SupportModulesDir>
	  <MelonNet6Dir>$(MelonLoaderDir)\net6</MelonNet6Dir>
	  <CommonModDir>$(ModManagerRoot)\Mods\IdleSlayerMods.Common</CommonModDir>
  </PropertyGroup>

  <!-- No mod manager installed: build against the snapshot in /Libraries, which can lag behind the game. -->
  <PropertyGroup Condition="'$(Il2CppAssembliesDir)' == ''">
	  <RepoLibrariesDir>$(MSBuildThisFileDirectory)..\Libraries</RepoLibrariesDir>
	  <Il2CppAssembliesDir>$(RepoLibrariesDir)</Il2CppAssembliesDir>
	  <SupportModulesDir>$(RepoLibrariesDir)</SupportModulesDir>
	  <MelonNet6Dir>$(RepoLibrariesDir)</MelonNet6Dir>
	  <CommonModDir>$(RepoLibrariesDir)</CommonModDir>
  </PropertyGroup>

  <ItemGroup>
    <None Include="PerfectChestHunter.csproj.user" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LavaGang.MelonLoader" Version="0.7.1" />
    <PackageReference Include="Lib.Harmony" Version="2.3.6" />
  </ItemGroup>

  <ItemGroup>
	  <Reference Include="IdleSlayerMods.Common">
		  <HintPath>$(CommonModDir)\IdleSlayerMods.Common.dll</HintPath>
		  <Private>False</Private>
	  </Reference>
	  <Reference Include="Assembly-CSharp">
		  <HintPath>$(Il2CppAssembliesDir)\Assembly-CSharp.dll</HintPath>
		  <Private>False</Private>
	  </Reference>
	  <Reference Include="Il2Cpp">
		  <HintPath>$(SupportModulesDir)\Il2Cpp.dll</HintPath>
		  <Private>False</Private>
	  </Reference>
	  <Reference Include="Il2CppInterop.Runtime">
		  <HintPath>$(MelonNet6Dir)\Il2CppInterop.Runtime.dll</HintPath>
		  <Private>False</Private>
	  </Reference>
	  <Reference Include="Il2Cppmscorlib">
		  <HintPath>$(Il2CppAssembliesDir)\Il2Cppmscorlib.dll</HintPath>
		  <Private>False</Private>
	  </Reference>
	  <Reference Include="Unity.TextMeshPro">
		  <HintPath>$(Il2CppAssembliesDir)\Unity.TextMeshPro.dll</HintPath>
		  <Private>False</Private>
	  </Reference>
	  <Reference Include="UnityEngine.AnimationModule">
		  <HintPath>$(Il2CppAssembliesDir)\UnityEngine.AnimationModule.dll</HintPath>
		  <Private>False</Private>
	  </Reference>
	  <Reference Include="UnityEngine.CoreModule">
		  <HintPath>$(Il2CppAssembliesDir)\UnityEngine.CoreModule.dll</HintPath>
		  <Private>False</Private>
	  </Reference>
	  <Reference Include="UnityEngine.InputLegacyModule">
		  <HintPath>$(Il2CppAssembliesDir)\UnityEngine.InputLegacyModule.dll</HintPath>
		  <Private>False</Private>
	  </Reference>
	  <Reference Include="UnityEngine.UI">
		  <HintPath>$(Il2CppAssembliesDir)\UnityEngine.UI.dll</HintPath>
		  <Private>False</Private>
	  </Reference>
	  <Reference Include="UnityEngine.UIModule">
		  <HintPath>$(Il2CppAssembliesDir)\UnityEngine.UIModule.dll</HintPath>
		  <Private>False</Private>
	  </Reference>
  </ItemGroup>

	<ItemGroup>
		<None Include="Assets\manifest.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Include="Assets\banner.png" Condition="Exists('Assets\banner.png')">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>


</Project>
